# ==========================================
# CONFIGURACIÓN DEL FRONTEND (Angular)
# ==========================================

# Variables disponibles para la aplicación
# Úsalas si tu stack las soporta (ej: @ngx-env/builder, webpack-dotenv)
# o simplemente como referencia para configurar los environment.ts

# Entorno local (desarrollo con ng serve)
# Angular por defecto usa el puerto 4200.
NG_APP_API_URL=http://localhost:8000/api/v1
NG_APP_ENV=development

# Entorno en producción (ejemplo de API hosteada)
#NG_APP_API_URL=https://api.tu-backend-produccion.com/api/v1
#NG_APP_ENV=production

# Feature flags (para habilitar o deshabilitar opciones)
NG_APP_ENABLE_ANALYTICS=false
